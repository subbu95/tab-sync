{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "cip-eclipse": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "standalone": false
        },
        "@schematics/angular:directive": {
          "standalone": false
        },
        "@schematics/angular:pipe": {
          "standalone": false
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "eclipse",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/cip-eclipse",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/assets",
              {
                "glob": "**/*",
                "input": "./node_modules/@nielseniq/crf-translate/assets/i18n/cuic-athena-core/",
                "output": "/assets/i18n/@nielsen/cuic-athena-core"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/@nielseniq/crf-translate/assets/i18n/crf-rc-features/",
                "output": "/assets/i18n/@nielsen/crf-rc-features"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/@nielseniq/crf-translate/assets/i18n/crf-rc-central/",
                "output": "/assets/i18n/@nielsen/crf-rc-central"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/@nielseniq/crf-translate/assets/i18n/crf-lp-common/",
                "output": "/assets/i18n/@nielsen/crf-lp-common"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/@nielseniq/crf-translate/assets/i18n/crf-rv-common/",
