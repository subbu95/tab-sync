                "output": "/assets/i18n/@nielsen/crf-global-nav"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/@nielseniq/crf-translate/assets/i18n/connect-chart-library/",
                "output": "/assets/i18n/@nielsen/connect-chart-library"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/@nielseniq/crf-translate/assets/i18n/crf-ui-components/",
                "output": "assets/i18n/@nielsen/crf-ui-components"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/@nielseniq/crf-translate/assets/i18n/crf-omni-templates/",
